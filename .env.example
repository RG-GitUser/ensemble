# Admin account (used at first database creation only)
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=change-me

# Threads publishing (Meta developer app → threads use case).
# In dev mode this works for accounts with a role on the app — no review needed.
# Redirect URI to register: <your-origin>/api/oauth/threads/callback
# THREADS_APP_ID=
# THREADS_APP_SECRET=

