# Copy to .env on the server and fill in — Next.js loads it at runtime.

# Hostnames that serve the platform itself (marketing site, dashboard, /s/ pages).
# Any OTHER Host header is treated as a creator's custom domain. Must include
# every host the Caddyfile routes to the app — sites.* included, or a direct
# visit to the CNAME target 404s as an unknown customer domain.
PLATFORM_HOSTS=ensemble.it.com,www.ensemble.it.com,sites.ensemble.it.com,localhost

# Absolute URL of the platform — used for links back to the dashboard from
# pages served on customer domains.
APP_URL=https://ensemble.it.com

# Shown in the dashboard's "Connect your domain" DNS instructions.
# DOMAIN_A_RECORD is the droplet's reserved IP.
DOMAIN_A_RECORD=203.0.113.10
DOMAIN_CNAME_TARGET=sites.ensemble.it.com

# Stripe subscription billing.
# In PRODUCTION, a missing STRIPE_SECRET_KEY no longer means "everything is
# free" — it fails closed, and paid features are unavailable until either this
# key is set or ENSEMBLE_BILLING_DISABLED=1 says the free mode is intended.
# Outside production a missing key still means preview mode.
# APP_URL above is what builds the Checkout return links, so if it is wrong
# or missing, customers pay and then get redirected to localhost.
# Products and prices create themselves on first use (ensemble_<plan>_monthly).
# The webhook endpoint is https://ensemble.it.com/api/stripe/webhook and must
# subscribe to exactly these events, which are the ones src/lib/billing.ts
# handles: checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed, customer.subscription.updated,
# customer.subscription.deleted, invoice.payment_failed.
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Run WITHOUT billing on purpose (self-hosting, a demo box, local development).
# Plan changes become instant and free. This has to be asked for explicitly:
# inferring it from a missing STRIPE_SECRET_KEY meant one forgotten line of
# config handed every signed-up account Enterprise for free.
# ENSEMBLE_BILLING_DISABLED=1

# Stripe Tax. Selling subscriptions across borders creates VAT and sales-tax
# obligations from the first invoice, and nothing here collects it unless this
# is on. Configure Tax in the Stripe dashboard FIRST (set your origin address
# and register your jurisdictions) — turning this on before that makes every
# checkout fail. Then set it to 1.
# STRIPE_AUTOMATIC_TAX=1

# Set to 1 to hold the launch. Signed-out visitors are redirected to the
# landing page, which also carries a "Work In Progress" overlay.
# Published creator pages still resolve, and so do /login, /privacy, /terms
# and /documents. /signup and /dashboard are redirected away, and non-GET
# requests to them are refused outright rather than redirected — a 307 keeps
# the method and body, and server actions are dispatched by an id in a header
# rather than by route, so a redirect alone still ran them.
# Anyone holding a session cookie passes straight through.
# NOTE: /api/ is excluded from the gate entirely (that is what keeps the Stripe
# webhook and unsubscribe links working), so API routes are served in WIP mode.
# Set to 0 (or delete the line) and restart to go live. See src/proxy.ts.
# WIP_MODE=1

# Admin account. The admin user is seeded on FIRST start and env changes do
# nothing afterwards, so this is a one-shot, permanent decision.
#
# ADMIN_PASSWORD is deliberately left COMMENTED OUT. It used to ship set to
# "change-me-before-first-run" while the runbook said `cp .env.example .env`
# before the first start — so missing the edit seeded the admin account, in a
# public repo, with a password published in that same repo, and the
# random-password safety net described here never fired because the variable
# was set. Leave it commented and the app generates a random password and
# prints it once to the server log (`journalctl -u ensemble`); save that, then
# rotate it deliberately.
#
# To change an already-seeded account: scripts/set-admin-password.mjs.
ADMIN_EMAIL=rileyg0035@gmail.com
# ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Sign in with Google / Microsoft / Yahoo
# ---------------------------------------------------------------------------
#
# Lets a creator sign in with an account they already have, instead of setting
# another password. Entirely optional: any provider without BOTH values below
# is not offered on the login or signup page at all, so leaving these commented
# out simply keeps the email-and-password form as the only way in.
#
# These are for SIGNING IN. The blocks further down are for PUBLISHING to a
# platform on a creator's behalf, and the two never share credentials or a
# callback — an app registered for one will not work for the other.
#
# An address is only accepted when the provider says it verified it. Google and
# Yahoo return an email_verified claim and we refuse the sign-in without it;
# with Microsoft the address IS the account, so the guarantee comes from the
# account model. See src/lib/login-providers.ts.

# Google Cloud console → APIs & Services → Credentials → OAuth client ID (Web).
# Redirect URI to register: https://ensemble.it.com/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Azure portal → App registrations → new registration, "Accounts in any
# organizational directory and personal Microsoft accounts" so Outlook.com
# works alongside work/school accounts.
# Redirect URI to register: https://ensemble.it.com/api/auth/microsoft/callback
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=

# Yahoo developer console → Create an App, with OpenID Connect permissions.
# Redirect URI to register: https://ensemble.it.com/api/auth/yahoo/callback
# YAHOO_CLIENT_ID=
# YAHOO_CLIENT_SECRET=

# Threads publishing (Meta developer app → threads use case).
# In dev mode this works for accounts with a role on the app — no review needed.
# Redirect URI to register: https://ensemble.it.com/api/oauth/threads/callback
# THREADS_APP_ID=
# THREADS_APP_SECRET=

# Instagram / Facebook (same Meta app as Threads, different products added).
# Publishers exist for both — they switch on the moment credentials appear.
# Redirect URIs: https://ensemble.it.com/api/oauth/{instagram,facebook}/callback
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=

# Pinterest (developers.pinterest.com/apps) and Reddit (reddit.com/prefs/apps).
# Both issue short-lived tokens; Ensemble refreshes them automatically.
# PINTEREST_APP_ID=
# PINTEREST_APP_SECRET=
# REDDIT_APP_ID=
# REDDIT_APP_SECRET=

# Coming next (no OAuth provider entry or publisher yet):
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=

# Scheduled posts and newsletters (DEPLOY.md §11).
#
# The app is request-driven and has nothing that wakes itself up, so cron POSTs
# /api/cron/run-due every minute with this secret in x-cron-secret. Leave it
# unset and the route answers 404: scheduling is simply off, and a prober is
# not told the endpoint exists.
#
# Generate one with: openssl rand -hex 32
# CRON_SECRET=

# Live relay (DEPLOY.md §10). Both must be set for the dashboard to show the
# ingest address.
#
# LIVE_HOOK_SECRET is ALSO needed by mediamtx.service, which now loads its own
# /etc/ensemble-relay.env containing only that one line. It used to load this
# whole file, which put every platform secret into the relay's environment and
# into every ffmpeg child it spawns. Copy the value across when you change it.
#
# Use rtmps:// once rtmpEncryption is on in deploy/mediamtx.yml — plain rtmp://
# carries the ingest key in cleartext, and creators stream from venue wifi.
# LIVE_INGEST_URL=rtmps://ensemble.it.com/live
# LIVE_HOOK_SECRET=

# Password-reset and other platform mail. Separate from MAIL_FROM below, which
# is the creators' newsletter sender and goes out under a creator's name — a
# reset link must never look like it came from a creator. Uses the same
# RESEND_API_KEY, so resets only send once that is set. The default is a
# send-only mailbox; replies to a reset link have nowhere useful to go.
# AUTH_MAIL_FROM=Ensemble <noreply@ensemble.it.com>

# Creator newsletters (Audience tab). Sending switches on when RESEND_API_KEY
# is set; until then lists still collect and the tab says sending is off.
# MAIL_FROM must be an address on a domain verified in the Resend dashboard —
# mail goes out from it with the creator's name displayed and their account
# email as reply-to.
# RESEND_API_KEY=
# MAIL_FROM=Ensemble <news@ensemble.it.com>
