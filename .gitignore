# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local database
data/

# keep the credential template
!.env.example

# local editor / tooling config
/.claude/
/CLAUDE.md
/AGENTS.md

# Local backups written by scripts/backup.sh
/backups/

# Duplicate files created by file-sync tools (the project lives under ~/Desktop).
# These are byte-identical copies; two of them landed in src/app route folders
# and broke `tsc` with duplicate-identifier errors before being caught.
*[[:space:]][0-9].ts
*[[:space:]][0-9].tsx
