# Ensemble — Caddy config (goes to /etc/caddy/Caddyfile on the droplet).

{
	# Let's Encrypt account email — expiry warnings go here.
	email rileyg0035@gmail.com

	# Customer-domain certificates are only issued if the app says the
	# hostname is a registered custom domain (fast SQLite lookup).
	on_demand_tls {
		ask http://localhost:3000/api/domains/check
	}
}

# Caddy calls the ask endpoint directly over localhost, so it never passes
# through a site block — blocking it at the edge costs nothing and stops
# anyone enumerating which hostnames are customers (it answers 200 vs 404).
# Imported into EVERY site block; a block missing it re-exposes the endpoint.
(block-ask-endpoint) {
	handle /api/domains/check* {
		respond 403
	}
}

# The platform itself — normal managed certificates.
ensemble.it.com, www.ensemble.it.com, sites.ensemble.it.com {
	import block-ask-endpoint
	handle {
		reverse_proxy localhost:3000
	}
}

# Every other hostname is a creator's custom domain: mint a cert on demand
# (gated by the ask endpoint above) and hand the request to the app, which
# routes by Host header (src/proxy.ts).
https:// {
	tls {
		on_demand
	}
	import block-ask-endpoint
	handle {
		reverse_proxy localhost:3000
	}
}
